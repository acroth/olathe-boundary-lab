# Supabase (Project Settings -> API). Server-only; never expose the service role key to the browser.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Optional, for future browser reads of public tables
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Pipeline publish step only (Project Settings -> Database -> Session pooler connection string)
DATABASE_URL=
# Feedback form: messages are emailed through this Gmail account.
# GMAIL_APP_PASSWORD is a 16-character app password (Google Account -> Security -> 2-Step Verification -> App passwords), not the normal password.
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=
# Optional: send feedback to a different inbox (defaults to GMAIL_USER)
FEEDBACK_TO=
